{
  "name": "library-app",
  "productName": "Library",
  "version": "0.7.0",
  "description": "One library for all your games and apps",
  "author": "Caden",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "sql.js": "^1.15.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.jxst.library",
    "productName": "Library",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Library-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Cade4537",
        "repo": "library-app",
        "releaseType": "release"
      }
    ]
  }
}
